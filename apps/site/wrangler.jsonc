{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "botui-site",
  // the account that owns botharness.ai, so `wrangler deploy` needs no --account flag
  "account_id": "332e72d480d7cb3e60ee671d3ca0cad0",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "preview_urls": true,
  "routes": [{ "pattern": "ui.botharness.ai", "custom_domain": true }],
}
