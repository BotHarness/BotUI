/**
 * The default locale lives at the root.
 *
 * Astro requires a root index page once i18n is configured, and `prefixDefaultLocale:
 * false` means this IS the English page rather than a redirect to one. The body is
 * shared with /zh/ so the two languages cannot drift apart.
 */
import Home from '../components/Home.astro';
