---
import Base from '../layouts/Base.astro';
import { InstallCommand } from './InstallCommand';
import { Playground } from './Playground';
import { RegistryList } from './RegistryList';
import LocaleSwitch from './LocaleSwitch.astro';
import { m } from '../paraglide/messages.js';
import { localizeHref, locales } from '../paraglide/runtime.js';

/**
 * The whole page, shared by both locales.
 *
 * The locale is NOT read from the URL here: the middleware has already called
 * `setLocale()` before this renders, so `m.*` resolves correctly. That is what lets
 * one body serve `/` (English) and `/zh/` (Chinese) — there is no second copy to
 * drift, which is the failure mode a duplicated page has.
 */
const locale = Astro.currentLocale ?? 'en';
const path = Astro.url.pathname;
---

<Base title={m.site_title()} description={m.site_description()} locale={locale}>
  <header class="top">
    <a class="brand" href={localizeHref(path, { locale })}><span>{m.brand()}</span></a>
    <nav>
      <a href={`#${m.nav_install()}`}>{m.nav_install()}</a>
      <a href={`#${m.nav_components()}`}>{m.nav_components()}</a>
      <a href="https://github.com/BotHarness/BotUI" rel="noreferrer">{m.nav_github()}</a>
      <!-- a real link to the other locale's FILE, not a client-side toggle: with two
           static files, /zh/ has to be reachable without JavaScript, and crawlable -->
      <LocaleSwitch current={locale} path={path} />
    </nav>
  </header>

  <main>
    <section class="hero" id={m.nav_install()}>
      <h1>{m.hero_title()}</h1>
      <p class="lede">{m.hero_lede()}</p>
      <InstallCommand command={m.install_command()} client:load />
      <p class="fine">
        {m.hero_also()}
        <code>npx shadcn@latest add https://ui.botharness.ai/r/dot-matrix.json</code>
      </p>
    </section>

    <!-- the playground is directly under the install command on purpose: the point of
         the page is to let you drag the thing you are about to install, so putting a
         component index between the two would be a detour. `client:load` rather than
         `client:visible` for the same reason — it must be interactive on arrival. -->
    <section class="playground-section">
      <Playground client:load />
    </section>

    <section id={m.nav_components()}>
      <h2>{m.components_heading()}</h2>
      <p class="fine">{m.components_note()}</p>
      <RegistryList client:visible />
    </section>

    <section>
      <h2>{m.why_heading()}</h2>
      <div class="prose-grid">
        <article>
          <h3>{m.why_own_title()}</h3>
          <p>{m.why_own_body()}</p>
        </article>
        <article>
          <h3>{m.why_version_title()}</h3>
          <p>{m.why_version_body()}</p>
        </article>
        <article>
          <h3>{m.why_layers_title()}</h3>
          <p>{m.why_layers_body()}</p>
        </article>
      </div>
    </section>
  </main>

  <footer>
    <p>{m.footer_license({ repo: 'BotHarness/BotUI' })}</p>
  </footer>
</Base>

{
  locales.map((l) => (
    <link rel="alternate" hreflang={l} href={localizeHref(path, { locale: l })} />
  ))
}
<link rel="alternate" hreflang="x-default" href={localizeHref(path, { locale: 'en' })} />
