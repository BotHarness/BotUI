node_modules/
dist/
*.tsbuildinfo
.DS_Store
.env
.env.*
!.env.example
# the registry is BUILT from packages/*, never hand-edited; the published copy
# is committed so the site and the CLI have a stable URL to serve

# the registry and the site bundle are BUILD OUTPUT of packages/* — committing a
# generated copy of the source is the one thing this repo is designed to prevent
apps/site/public/registry.json
apps/site/public/r/
apps/site/dist/
apps/site/.astro/
apps/site/src/paraglide/

# the npm publish token: a secret, machine-local, never committed. `scripts/npm-token.sh`
# creates it on demand and `scripts/release.mjs` reads it. Ignored by name rather
# than by a pattern, so an unrelated file can never be swept up by a wildcard.
npm_release.token
npm_release.token.export
