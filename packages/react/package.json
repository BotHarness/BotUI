{
  "name": "@botharness/botui-react",
  "version": "0.1.0",
  "description": "React bindings for BotUI components",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
