{
  "name": "@botharness/botui-react",
  "version": "0.1.2",
  "description": "React bindings for BotUI components",
  "keywords": [
    "agent-ui",
    "animation",
    "dot-matrix",
    "indicator",
    "loading",
    "react",
    "status",
    "streaming"
  ],
  "homepage": "https://ui.botharness.ai",
  "bugs": {
    "url": "https://github.com/BotHarness/BotUI/issues",
    "source": "https://github.com/BotHarness/BotUI/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BotHarness/BotUI.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@botharness/botui-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "react": "^19.2.0",
    "tsdown": "^0.20.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
