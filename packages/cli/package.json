{
  "name": "@botharness/botui",
  "version": "0.1.0",
  "description": "Install BotUI components into your project — copy-and-own, like shadcn",
  "license": "MIT",
  "bin": {
    "botui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
