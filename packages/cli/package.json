{
  "name": "@botharness/botui",
  "version": "0.1.1",
  "description": "Install BotUI components into your project — copy-and-own, like shadcn",
  "keywords": [
    "agent-ui",
    "cli",
    "copy-and-own",
    "dot-matrix",
    "npx",
    "registry",
    "shadcn"
  ],
  "homepage": "https://ui.botharness.ai",
  "bugs": {
    "url": "https://github.com/BotHarness/BotUI/issues",
    "source": "https://github.com/BotHarness/BotUI/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BotHarness/BotUI.git",
    "directory": "packages/cli"
  },
  "bin": {
    "botui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
