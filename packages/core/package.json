    "agent-ui",
    "animation",
    "css",
    "dot-matrix",
    "indicator",
    "keyframes",
    "loading",
    "status",
    "streaming",
    "svg"
  ],
  "homepage": "https://ui.botharness.ai",
  "bugs": {
