{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@botharness/botui-core": ["packages/core/src/index.ts"],
      "@botharness/botui-core/*": ["packages/core/src/*"],
      "@botharness/botui-react": ["packages/react/src/index.ts"],
      "@botharness/botui": ["packages/cli/src/index.ts"]
    }
  }
}
